&CONTROL
  calculation = 'scf'
  prefix = 'MoSe2_2H'
  pseudo_dir = './pseudos'
  outdir = './out'
  disk_io = 'nowf'
/
&SYSTEM
  ibrav = 4
  a = 3.3428
  c = 18.0
  nat = 6
  ntyp = 2
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.02
/
&ELECTRONS
  mixing_beta = 0.7
  conv_thr = 1.0d-6
  diagonalization = 'david'
  electron_maxstep = 60
/
